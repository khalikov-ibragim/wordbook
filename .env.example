# Скопируй в .env и заполни своими значениями
PORT=3000

DB_HOST=bd
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wordbook


# Строка подключения к Postgres
DATABASE_URL=postgresql://wordbook_user:wordbook_pass@localhost:5432/wordbook

# LibreTranslate: публичный сервер (лимиты, может требовать api_key)
# или адрес своего самохостнутого инстанса, например http://localhost:5001
LIBRETRANSLATE_URL=http://libretranslate:5000/translate
LIBRETRANSLATE_API_KEY=
LT_LOAD_ONLY=en,ru

# Разрешённый origin фронтенда (CORS). Важно: если оставить пустым,
# кросс-доменные запросы теперь ЗАПРЕЩЕНЫ по умолчанию (раньше по
# умолчанию было '*' — полностью открытый CORS, это было дырой).
# На проде (фронтенд и бэкенд на одном домене через nginx) можно вообще
# не задавать — same-origin запросы CORS не касается. Задавай, только
# если реально держишь фронтенд на другом origin (например, локальная
# разработка с live-server на своём порту).
FRONTEND_ORIGIN=http://localhost:5173

# Ключ для простой авторизации API (заголовок X-API-Key). Сервер открыт
# наружу через nginx (443/80) — без ключа кто угодно, кто узнает домен,
# сможет читать/менять/удалять твои записи. Сгенерировать случайный ключ:
#   openssl rand -hex 24
# Этот же ключ нужно будет один раз вписать во фронтенде (шестерёнка в
# шапке приложения → API-ключ) — он сохранится в localStorage браузера.
# Если оставить пустым — авторизация выключена (для локальной разработки
# это ок, для сервера, доступного из интернета — нет; backend напечатает
# предупреждение в лог при старте, если ключ не задан).

# --- Автозагрузка словаря (см. docs/INFRA.md, раздел "Данные для словаря") ---
# true — при каждом старте backend сам проверяет таблицу dictionary: если
# она пустая, скачивает открытый словарь и наполняет и Postgres (большой
# серверный словарь), и офлайн-бандлы для устройства (backend/data/). Если
# dictionary уже не пустая — шаг почти мгновенно пропускается, так что флаг
# можно смело держать включённым постоянно.
AUTO_IMPORT_DICTIONARY=true

# Источник исходных данных по умолчанию — открытый словарь проекта
# OpenRussian.org (репозиторий Badestrand/russian-dictionary на GitHub,
# лицензия CC BY-SA 4.0 — атрибуция обязательна при публичном
# использовании, см. INFRA.md). Можно подставить свой источник в том же
# формате (TSV с колонками bare / translations_en).
DICTIONARY_SOURCE_BASE_URL=https://github.com/Badestrand/russian-dictionary/raw/refs/heads/master
DICTIONARY_SOURCE_FILES=others.csv,nouns.csv,verbs.csv,adjectives.csv

# Сколько слов на файл-источник (их по умолчанию 4) попадает в компактный
# офлайн-бандл для устройства. Источники уже отсортированы по частотности,
# поэтому это буквально "самые частые слова". 8000 x 4 ≈ 30000 слов на
# устройство — то же число, что упоминается в docs/LOGIC.md.
DEVICE_BUNDLE_LIMIT_PER_FILE=8000

PGADMIN_DEFAULT_EMAIL=mypostgres@example.com
PGADMIN_DEFAULT_PASSWORD=mypostgres

#Postgres

POSTGRES_DB=wordbook
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

#certbot

DUCKDNS_TOKEN=3f846625-204d-4ab7-8a4f-d914d0fb91c0